<?xml version="1.0" encoding="utf-8"?>
<!-- Depth, incoming app: arrives from the bar, on the side of the icon you touched, and
     comes forward into place. Fully opaque within the first third so it reads as solid. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false"
    android:zAdjustment="top">
    <alpha android:fromAlpha="0" android:toAlpha="1"
        android:duration="150" android:interpolator="@interpolator/fold_decel" />
    <scale android:fromXScale="0.84" android:toXScale="1" android:fromYScale="0.84" android:toYScale="1"
        android:pivotX="78%" android:pivotY="0%"
        android:duration="460" android:interpolator="@interpolator/fold_decel" />
    <translate android:fromYDelta="-7%" android:toYDelta="0"
        android:duration="460" android:interpolator="@interpolator/fold_decel" />
</set>
